# ─────────────────────────────────────────────────────────────────
#  Cinema Plus — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────

# ── Application Environment ─────────────────────────────────────
# Options: development | production
APP_ENV=development

# ── Database (MySQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password_here
DB_NAME=MovieTicketBooking

# ── JWT Security ─────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. Must be at least 32 characters.
SECRET_KEY=replace_this_with_a_cryptographically_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Admin Account Bootstrap ──────────────────────────────────────
# Used to create the initial admin account on first startup.
# REQUIRED in production — app will refuse to start without this.
# Must be a strong password (8+ characters).
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_EMAIL=admin@your-domain.com

# ── CORS (Frontend Origin) ───────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:3005
# Production: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:3005

# ── Frontend URL ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3005

# ── Backend API URL (for internal references) ───────────────────
API_BASE_URL=http://localhost:8001

# ── Reservations ─────────────────────────────────────────────────
RESERVATION_TIMEOUT_MINUTES=10

# ── OpenAPI Documentation ────────────────────────────────────────
# Set to "true" to enable /docs and /redoc in production.
# In development, docs are always enabled.
ENABLE_DOCS=false

# ── SMTP Email (optional) ────────────────────────────────────────
# If SMTP_USER and SMTP_PASS are not set, email is silently skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@your-domain.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

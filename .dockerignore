# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
.venv/
venv/
ENV/
*.db
*.sqlite3
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.pytype/

# Node.js / Next.js
node_modules/
npm-debug.log*
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo

# Environment / Secrets — NEVER bake these into images
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
cache/
.cache/

# Git
.git/
.gitignore

# Coverage / Reports
coverage/
lcov-report/
*.lcov
reports/

# Uploads — do NOT bake user uploads into the image
# They should be mounted as a persistent volume at runtime
uploads/posters/*
uploads/banners/*
uploads/media/*
!uploads/defaults/

# Legacy / Archive
legacy/

# ─────────────────────────────────────────────────────────────────
#  Cinema Plus — Frontend Environment Variables (Next.js)
#  Copy this file to .env.local and fill in your real values.
#  NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────

# ── Backend API URL ──────────────────────────────────────────────
# Development: point to your local backend
# Production: point to your deployed backend URL
# Example production value: https://api.your-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# ── Optional: Enable React profiling in production ───────────────
# Set to "true" only when profiling performance.
# NEVER set to "true" in normal production deployments (slower build).
# REACT_PROFILE=false
